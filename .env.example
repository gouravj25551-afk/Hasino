# local dev
DATABASE_URL=postgres://localhost:5432/hasino_dev
TEST_DATABASE_URL=postgres://localhost:5432/hasino_test

# Redis (BullMQ + availability snapshot cache)
REDIS_URL=redis://localhost:6379

# Firebase Auth — server-side token verification. Provide ONE of these two.
# FIREBASE_SERVICE_ACCOUNT is inline JSON (suits Railway/Render/Fly);
# GOOGLE_APPLICATION_CREDENTIALS is a path (what Cloud Run injects for free).
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account",...}
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json

# Firebase Auth — client config. Not secret, but environment-specific, so it
# is served to the browser from GET /api/config instead of being hardcoded.
# Values come from Firebase console > Project settings > General > Your apps.
FIREBASE_WEB_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_APP_ID=
