# ---------- local dev ----------
DATABASE_URL=postgres://localhost:5432/hasino_dev
TEST_DATABASE_URL=postgres://localhost:5432/hasino_test

# Bind port and environment. NODE_ENV=production makes start() refuse to boot
# without real credentials — see src/http/server.ts.
PORT=3000
# NODE_ENV=production

# ---------- Clerk Auth ----------
# Dashboard > API keys. Both come from the same place.
#
# CLERK_PUBLISHABLE_KEY (pk_test_* / pk_live_*) is NOT secret — it is served to
# every browser from GET /api/config, which is how the frontend boots clerk-js.
# CLERK_SECRET_KEY (sk_test_* / sk_live_*) signs and reads on the server and
# must never leave it. Production refuses to boot without both.
CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=

# In the Clerk dashboard you must also:
#   - User & Authentication > Social Connections: enable Google
#   - User & Authentication > Email, Phone, Username: enable Phone number
#     (Google carries no phone, and users.phone is NOT NULL because a salon has
#     to ring the customer — it is also how a salon owner claims the account an
#     admin created for them)
#   - Domains: add http://localhost:3000 for local development

# ---------- who is an admin ----------
# The single source of truth. Comma separated. Re-derived on every sign-in in
# both directions: an address here is promoted to admin, and an admin whose
# address is removed is demoted on their next sign-in. users.role is a cache of
# this, never the other way round — a sticky admin row that outlives its entry
# here is exactly the thing that gets forgotten and then exploited.
#
# Requires a VERIFIED email on the token, so enable Google sign-in (which
# verifies) rather than relying on an unverified claim.
ADMIN_EMAILS=

# ---------- Razorpay ----------
# Dashboard > Account & Settings > API Keys. rzp_test_* against the test mode
# sandbox; rzp_live_* only once the account is activated.
#
# Without these, dev runs against an in-process stub and production refuses to
# boot — a server that takes bookings without taking money is worse than one
# that will not start.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Create bookings without taking money — local work on the booking path only.
# With no keys and no flag, POST /api/bookings is 503 PAYMENTS_DISABLED, which
# is better than silently handing out free chairs. Production refuses to boot
# with this set.
# ALLOW_UNPAID_BOOKINGS=true

# A DIFFERENT secret from the API key: Dashboard > Settings > Webhooks, set when
# you create the endpoint. Point it at https://<your-host>/api/webhooks/razorpay
# and subscribe to: payment.captured, payment.failed, order.paid,
# refund.processed, refund.failed.
#
# This is the backstop for every customer who closes the tab mid-payment. With
# it unset they are debited and get no booking.
RAZORPAY_WEBHOOK_SECRET=

# Platform cut in basis points, applied to new salons at insert time.
# 1500 = 15%. Per-salon overrides live in salons.commission_bps.
PLATFORM_COMMISSION_BPS=1500

# How long a chair is held while the customer pays, in ms. Razorpay checkout
# allows ~5 minutes for a bank/UPI redirect; 8 minutes covers that plus the
# webhook. Shorter frees abandoned chairs sooner but strands slow payers.
PAYMENT_HOLD_TTL_MS=480000

# ---------- notifications ----------
# With no provider set, emails are printed to stdout instead of sent — which is
# what you want locally and never what you want in production.
# RESEND_API_KEY=
# EMAIL_FROM=Hasino <bookings@yourdomain.com>

# ---------- ops ----------
# json (default in production) or pretty (default on a TTY)
# LOG_FORMAT=json
# LOG_LEVEL=info

# Requests per minute per client for the global limit. Booking and auth have
# their own, tighter budgets in src/http/server.ts.
RATE_LIMIT_PER_MIN=300

# Set ONLY when the process actually sits behind a proxy that appends
# X-Forwarded-For. With no proxy in front, trusting that header lets any caller
# forge a fresh client identity per request and bypass rate limiting entirely.
# TRUST_PROXY=true

# Origins allowed to call the API cross-site — for the React Native and Next.js
# clients. Comma separated, exact matches. Empty means same-origin only.
# ALLOWED_ORIGINS=https://app.hasino.in,https://business.hasino.in

# false on a web tier that has a separate worker dyno. The advisory locks in
# src/workers/runner.ts make running them in several processes safe either way.
# RUN_WORKERS=true

# Redis (BullMQ + a shared availability snapshot cache) — not wired yet. The
# cache is in-process today, which is correct for one instance and merely
# wasteful for several.
# REDIS_URL=redis://localhost:6379
